# Embeddings y generación
OPENAI_API_KEY=sk-...

# OCR de PDFs (digitales y escaneados)
MISTRAL_API_KEY=...

# Postgres con pgvector >= 0.8.
# Cualquier cliente que sepa llamar a una función de Postgres sirve;
# el tipo RpcClient de src/types.ts declara el mínimo que se necesita.
DATABASE_URL=postgresql://user:pass@host:5432/dbname
